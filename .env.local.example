# Copy this to .env.local and fill in real values.
# The site will run without Firebase (forms logged to console in dev),
# but admin auth + storage require a configured project.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin allow-list (comma separated emails)
NEXT_PUBLIC_ADMIN_EMAILS=